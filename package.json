{
  "name": "space-oregon-trail",
  "version": "0.0.1",
  "private": true,
  "description": "The Proxima Trail: a space reimagining of The Oregon Trail, built by a team of AI agents.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "kanban": "node scripts/kanban.mjs",
    "kanban:build": "node scripts/kanban.mjs build",
    "kanban:open": "node scripts/kanban.mjs open",
    "balance": "node scripts/balance.mjs",
    "brainstorm": "node scripts/brainstorm.mjs",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:visual:update": "playwright test tests/e2e/visual.spec.ts --update-snapshots"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
